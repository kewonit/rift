    },
    "The filter says it’s on, but no connection has reached Rift for %lld minutes while the network is up. Your rules may not be applying." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Der Filter meldet, dass er eingeschaltet ist, aber seit %lld Minute hat keine Verbindung Rift erreicht, obwohl das Netzwerk verfügbar ist. Deine Regeln werden möglicherweise nicht angewendet."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
