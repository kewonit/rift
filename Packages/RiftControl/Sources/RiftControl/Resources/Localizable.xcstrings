        "es" : {
          "variations" : {
            "plural" : {
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El filtro indica que está activado, pero ninguna conexión ha llegado a Rift en %lld minutos con la red activa. Puede que tus reglas no se estén aplicando."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "El filtro indica que está activado, pero ninguna conexión ha llegado a Rift en %lld minuto con la red activa. Puede que tus reglas no se estén aplicando."
                }
              },
              "other" : {
                "stringUnit" : {
