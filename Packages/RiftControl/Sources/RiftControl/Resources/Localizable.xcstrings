                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Le filtre se dit activé, mais aucune connexion n’a atteint Rift depuis %lld minute alors que le réseau fonctionne. Vos règles ne s’appliquent peut-être pas."
                }
              },
