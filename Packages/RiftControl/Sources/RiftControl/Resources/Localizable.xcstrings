    },
    "The configuration is locked. Rules, profiles, modes and settings can’t be changed until you unlock it. Alerts can still be answered once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration ist gesperrt. Regeln, Profile, Modi und Einstellungen können erst geändert werden, wenn du sie entsperrst. Abfragen lassen sich weiterhin einmalig beantworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración está bloqueada. No se pueden cambiar reglas, perfiles, modos ni ajustes hasta que la desbloquees. Las alertas se pueden seguir respondiendo una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration est verrouillée. Les règles, profils, modes et réglages ne peuvent pas être modifiés tant que vous ne l’avez pas déverrouillée. Vous pouvez toujours répondre aux alertes une fois."
          }
        }
      }
    },
