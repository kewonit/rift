    "This app is signed only by itself, so Rift can’t tell who made it. A rule for it stops working when it’s rebuilt or updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist nur selbstsigniert, daher kann Rift nicht erkennen, von wem sie stammt. Eine Regel für sie funktioniert nicht mehr, wenn sie neu erstellt oder aktualisiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta app solo está firmada por sí misma, así que Rift no puede saber quién la creó. Una regla para ella deja de funcionar cuando se recompila o se actualiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app est signée uniquement par elle-même : Rift ne peut donc pas savoir qui l’a créée. Une règle la concernant cesse de fonctionner quand elle est recompilée ou mise à jour."
          }
        }
      }
