    },
    "The helper that made this connection is signed only by itself, so Rift can’t tell who made it. A rule for it stops working when it’s rebuilt or updated." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hilfsprozess, der diese Verbindung hergestellt hat, ist nur selbstsigniert, daher kann Rift nicht erkennen, von wem er stammt. Eine Regel dafür funktioniert nicht mehr, wenn er neu erstellt oder aktualisiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso auxiliar que hizo esta conexión solo está firmado por sí mismo, así que Rift no puede saber quién lo creó. Una regla para él deja de funcionar cuando se recompila o se actualiza."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le processus auxiliaire à l’origine de cette connexion est signé uniquement par lui-même : Rift ne peut donc pas savoir qui l’a créé. Une règle le concernant cesse de fonctionner quand il est recompilé ou mis à jour."
          }
        }
      }
    },
    "The helper that made this connection is signed with a certificate Apple didn’t issue, so Rift can’t confirm who made it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hilfsprozess, der diese Verbindung hergestellt hat, ist mit einem Zertifikat signiert, das Apple nicht ausgestellt hat, daher kann Rift nicht bestätigen, von wem er stammt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proceso auxiliar que hizo esta conexión está firmado con un certificado que no emitió Apple, así que Rift no puede confirmar quién lo creó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le processus auxiliaire à l’origine de cette connexion est signé avec un certificat qu’Apple n’a pas émis : Rift ne peut donc pas confirmer qui l’a créé."
          }
        }
      }
    },
