    },
    "Rift is watching" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift beobachtet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift está vigilando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift surveille"
          }
        }
      }
    },
    "Rift isn’t filtering yet. All connections are allowed until setup is done." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift filtert noch nicht. Bis die Einrichtung abgeschlossen ist, werden alle Verbindungen erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift aún no está filtrando. Se permiten todas las conexiones hasta que termine la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift ne filtre pas encore. Toutes les connexions sont autorisées jusqu’à la fin de la configuration."
          }
        }
      }
    },
    "Rift isn’t seeing connections" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift sieht keine Verbindungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift no está viendo conexiones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift ne voit aucune connexion"
          }
        }
      }
    },
    "Rift needs attention" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift braucht deine Aufmerksamkeit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift necesita tu atención"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift requiert votre attention"
          }
        }
      }
    },
    "Rift will allow all connections and stop applying your rules. You’ll still see activity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift erlaubt dann alle Verbindungen und wendet deine Regeln nicht mehr an. Aktivität siehst du weiterhin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift permitirá todas las conexiones y dejará de aplicar tus reglas. Seguirás viendo la actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift autorisera toutes les connexions et cessera d’appliquer vos règles. Vous verrez toujours l’activité."
          }
        }
      }
    },
    "Rift will block every connection that no rule allows. Apps without an allow rule lose network access. Rift filters TCP and UDP only, so other traffic, such as ping, isn’t blocked." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift blockiert jede Verbindung, die keine Regel erlaubt. Apps ohne erlaubende Regel verlieren den Netzwerkzugriff. Rift filtert nur TCP und UDP, anderer Datenverkehr wie Ping wird also nicht blockiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift bloqueará todas las conexiones que ninguna regla permita. Las apps sin una regla que las permita pierden el acceso a la red. Rift solo filtra TCP y UDP, así que otro tráfico, como ping, no se bloquea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift bloquera toute connexion qu’aucune règle n’autorise. Les apps sans règle d’autorisation perdront l’accès au réseau. Rift ne filtre que TCP et UDP : le reste du trafic, comme ping, n’est pas bloqué."
          }
        }
      }
    },
    "Rift’s configuration is locked, so you can only answer once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration von Rift ist gesperrt, daher kannst du nur einmalig antworten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de Rift está bloqueada, así que solo puedes responder una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de Rift est verrouillée, vous ne pouvez donc répondre qu’une fois."
          }
        }
      }
    },
    "Rift’s configuration is locked. Choose Unlock Configuration… (⌘L) in the Rift menu to make changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration von Rift ist gesperrt. Wähle „Konfiguration entsperren …“ (⌘L) im Menü „Rift“, um Änderungen vorzunehmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración de Rift está bloqueada. Para hacer cambios, elige Desbloquear configuración… (⌘L) en el menú Rift."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration de Rift est verrouillée. Pour la modifier, choisissez Déverrouiller la configuration… (⌘L) dans le menu Rift."
          }
        }
      }
    },
