    "It isn’t signed with Apple’s network filter permission, so it can’t see or block connections." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist nicht mit Apples Berechtigung für Netzwerkfilter signiert und kann daher keine Verbindungen sehen oder blockieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tiene la firma con el permiso de filtro de red de Apple, así que no puede ver ni bloquear conexiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle n’est pas signée avec l’autorisation de filtre réseau d’Apple : elle ne peut donc ni voir ni bloquer les connexions."
          }
        }
      }
    },
    "It’s installed but turned off, so all connections are allowed." : {
