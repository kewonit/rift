	<string>5MKDluJVSqikzPFSISw0xL9+ASUP9/TRFDA/TpwUuCg=</string>
	<key>SUVerifyUpdateBeforeExtraction</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.rift.firewall</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>rift</string>
			</array>
		</dict>
	</array>
	<key>RiftAppGroupIdentifier</key>
