    "No rule is redundant. A rule is redundant when another rule already does the same for everything it covers, so deleting it changes nothing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Regel ist überflüssig. Eine Regel ist überflüssig, wenn eine andere Regel für alles, was sie abdeckt, bereits dasselbe tut. Sie zu löschen ändert also nichts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna regla es redundante. Una regla es redundante cuando otra regla ya hace lo mismo con todo lo que cubre, así que eliminarla no cambia nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune règle n’est redondante. Une règle est redondante quand une autre règle fait déjà la même chose pour tout ce qu’elle couvre ; la supprimer ne change donc rien."
          }
        }
      }
