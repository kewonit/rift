    },
    "Rift couldn’t hide these connections. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift konnte diese Verbindungen nicht ausblenden. Versuche es erneut."
