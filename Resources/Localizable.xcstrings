            "value" : "Rift n’a pas pu joindre le serveur."
          }
        }
      }
    },
    "Rift couldn’t read its list of domain suffixes, so it can’t check subdomain rules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift konnte seine Liste der Domain-Suffixe nicht lesen und kann daher keine Subdomain-Regeln prüfen."
