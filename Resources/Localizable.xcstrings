    },
    "Rift couldn’t import this file. Your blocklists haven’t changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift konnte diese Datei nicht importieren. Deine Sperrlisten sind unverändert."
