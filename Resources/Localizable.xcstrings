    "Nothing to export. The .lsrules format can’t express the selected rules, such as temporary rules, rules for one profile, or rules for system processes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts zu exportieren. Das .lsrules-Format kann die ausgewählten Regeln nicht abbilden, etwa befristete Regeln, Regeln für ein einzelnes Profil oder Regeln für Systemprozesse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada que exportar. El formato .lsrules no puede representar las reglas seleccionadas, como las reglas temporales, las reglas para un solo perfil o las reglas para procesos del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
