    "This address is on a blocklist. To let it in, turn off its entry in Settings › Blocklists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Adresse steht auf einer Sperrliste. Um sie durchzulassen, schalte ihren Eintrag in Einstellungen › Sperrlisten aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
