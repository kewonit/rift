    "Recovery didn’t finish, and Rift couldn’t put the original configuration back. A private copy is in the Configuration Quarantine folder. Check it before you try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Wiederherstellung wurde nicht abgeschlossen, und Rift konnte die ursprüngliche Konfiguration nicht zurückholen. Eine private Kopie liegt im Ordner „Configuration Quarantine“. Prüfe sie, bevor du es erneut versuchst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación no terminó y Rift no pudo restaurar la configuración original. Hay una copia privada en la carpeta Configuration Quarantine. Revísala antes de volver a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La récupération n’a pas abouti et Rift n’a pas pu rétablir la configuration d’origine. Une copie privée se trouve dans le dossier Configuration Quarantine. Vérifiez-la avant de réessayer."
          }
        }
      }
    },
    "Recovery import: %lld rules, %lld profiles, %lld groups, and %lld blocklists. Rift keeps a private copy of the damaged configuration." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellungsimport: %1$lld Regeln, %2$lld Profile, %3$lld Gruppen und %4$lld Sperrlisten. Rift behält eine private Kopie der beschädigten Konfiguration."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Recovery import: %1$lld rules, %2$lld profiles, %3$lld groups, and %4$lld blocklists. Rift keeps a private copy of the damaged configuration."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importación de recuperación: %1$lld reglas, %2$lld perfiles, %3$lld grupos y %4$lld listas de bloqueo. Rift guarda una copia privada de la configuración dañada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importation de récupération : %1$lld règles, %2$lld profils, %3$lld groupes et %4$lld listes de blocage. Rift conserve une copie privée de la configuration endommagée."
          }
        }
      }
    },
    "Recovery stopped. Your configuration hasn’t changed, but Rift couldn’t remove a temporary copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellung abgebrochen. Deine Konfiguration ist unverändert, aber Rift konnte eine temporäre Kopie nicht entfernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La recuperación se detuvo. Tu configuración no ha cambiado, pero Rift no pudo eliminar una copia temporal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération interrompue. Votre configuration n’a pas changé, mais Rift n’a pas pu supprimer une copie temporaire."
          }
        }
      }
    },
