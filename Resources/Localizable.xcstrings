    "The change wasn’t saved. Make sure the name isn’t already in use, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung wurde nicht gespeichert. Stelle sicher, dass der Name nicht schon verwendet wird, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó el cambio. Asegúrate de que el nombre no esté ya en uso y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification n’a pas été enregistrée. Vérifiez que le nom n’est pas déjà utilisé, puis réessayez."
          }
        }
      }
    },
    "The change wasn’t saved. Your rules may have changed, so check them and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Änderung wurde nicht gespeichert. Deine Regeln haben sich möglicherweise geändert. Prüfe sie und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó el cambio. Puede que tus reglas hayan cambiado, así que revísalas y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modification n’a pas été enregistrée. Vos règles ont peut-être changé : vérifiez-les et réessayez."
          }
        }
      }
    },
    "The configuration wasn’t reset, and all traffic may be allowed for now. Try again while signed in to the Mac account that manages Rift." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration wurde nicht zurückgesetzt, und möglicherweise wird vorerst der gesamte Datenverkehr erlaubt. Versuche es erneut, während du mit dem Mac-Benutzeraccount angemeldet bist, der Rift verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración no se restableció y puede que, por ahora, se permita todo el tráfico. Vuelve a intentarlo con la sesión iniciada en la cuenta del Mac que gestiona Rift."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration n’a pas été réinitialisée, et tout le trafic est peut-être autorisé pour le moment. Réessayez en étant connecté au compte Mac qui gère Rift."
          }
        }
      }
    },
    "The copies are saved as new rules." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopien werden als neue Regeln gespeichert."
