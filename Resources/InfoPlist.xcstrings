    "NSSystemExtensionUsageDescription" : {
      "comment" : "Privacy - System Extension Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift verwendet einen Netzwerkfilter, um deine Verbindungsregeln auf diesem Mac anzuwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift uses a network filter to apply your connection rules on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift usa un filtro de red para aplicar tus reglas de conexión en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rift utilise un filtre réseau pour appliquer vos règles de connexion sur ce Mac."
