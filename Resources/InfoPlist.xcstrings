{
  "sourceLanguage" : "en",
  "strings" : {
    "NSLocationUsageDescription" : {
      "comment" : "Privacy - Location Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt einer App, WLAN-Namen nur mit den Ortungsdiensten zu lesen. Rift liest nur den Netzwerknamen, um Profile je nach Netzwerk zu wechseln, und niemals den Standort des Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lets an app read Wi-Fi network names only with Location Services. Rift reads only the network name, to switch profiles by network, and never the Mac’s location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo permite que una app lea los nombres de las redes Wi-Fi con Localización. Rift solo lee el nombre de la red, para cambiar de perfil según la red, y nunca la ubicación del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne permet à une app de lire le nom des réseaux Wi-Fi qu’avec le Service de localisation. Rift ne lit que le nom du réseau, pour changer de profil selon le réseau, et jamais la position du Mac."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
