          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie et reçoit les messages de l’app Messages."
          }
        }
      }
    },
    "Sends crash and diagnostic reports to Apple, if you turned on sharing in Privacy & Security › Analytics & Improvements." : {
      "comment" : "What the macOS service com.apple.SubmitDiagReports does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Absturz- und Diagnoseberichte an Apple, wenn du das Teilen in Datenschutz & Sicherheit › Analyse & Verbesserungen eingeschaltet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a Apple informes de fallos y de diagnóstico si activaste la opción de compartirlos en Privacidad y seguridad › Análisis y mejoras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie les rapports de plantage et de diagnostic à Apple, si vous avez activé le partage dans Confidentialité et sécurité › Analyse et améliorations."
          }
        }
      }
    },
    "Sends diagnostic and usage data to Apple, if you turned on sharing in Privacy & Security › Analytics & Improvements." : {
      "comment" : "What the macOS service com.apple.analyticsd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet Diagnose- und Nutzungsdaten an Apple, wenn du das Teilen in Datenschutz & Sicherheit › Analyse & Verbesserungen eingeschaltet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía a Apple datos de diagnóstico y de uso si activaste la opción de compartirlos en Privacidad y seguridad › Análisis y mejoras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie des données de diagnostic et d’utilisation à Apple, si vous avez activé le partage dans Confidentialité et sécurité › Analyse et améliorations."
          }
        }
      }
    },
    "Sets the clock from network time servers." : {
      "comment" : "What the macOS service com.apple.timed does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Uhr anhand von Netzwerk-Zeitservern."
          }
        },
