{
  "sourceLanguage" : "en",
  "strings" : {
    "Checks for and downloads macOS and security updates." : {
      "comment" : "What the macOS service com.apple.softwareupdated does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht nach macOS- und Sicherheitsupdates und lädt sie herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca y descarga actualizaciones de macOS y de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche et télécharge les mises à jour de macOS et de sécurité."
          }
        }
      }
    },
    "Checks the certificates of secure connections, and whether a certificate has been revoked, for apps and macOS." : {
      "comment" : "What the macOS service com.apple.trustd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüft für Apps und macOS die Zertifikate sicherer Verbindungen und ob ein Zertifikat widerrufen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba los certificados de las conexiones seguras, y si se ha revocado alguno, para las apps y macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les certificats des connexions sécurisées, et s’ils ont été révoqués, pour les apps et macOS."
          }
        }
      }
    },
    "Downloads App Store purchases and app updates." : {
      "comment" : "What the macOS service com.apple.storedownloadd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt App Store-Käufe und App-Updates herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga las compras del App Store y las actualizaciones de apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les achats de l’App Store et les mises à jour des apps."
          }
        }
      }
    },
    "Downloads and uploads files in the background on behalf of apps and macOS, so transfers continue after an app quits." : {
      "comment" : "What the macOS service com.apple.nsurlsessiond does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt im Hintergrund Dateien für Apps und macOS herunter und hoch, damit Übertragungen weiterlaufen, nachdem eine App beendet wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga y sube archivos en segundo plano en nombre de las apps y de macOS, para que las transferencias continúen después de cerrar una app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge et envoie des fichiers en arrière-plan pour les apps et macOS, afin que les transferts se poursuivent après la fermeture d’une app."
          }
        }
      }
    },
    "Downloads content for the Tips app." : {
      "comment" : "What the macOS service com.apple.tipsd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Inhalte für die App „Tipps“ herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga contenido para la app Consejos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge le contenu de l’app Astuces."
          }
        }
      }
    },
    "Downloads help pages for apps and macOS." : {
      "comment" : "What the macOS service com.apple.helpd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Hilfeseiten für Apps und macOS herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga páginas de ayuda para las apps y macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les pages d’aide des apps et de macOS."
          }
        }
      }
    },
    "Downloads maps, places and location data for Maps and other apps." : {
      "comment" : "What the macOS service com.apple.geod does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Karten, Orte und Standortdaten für „Karten“ und andere Apps herunter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga mapas, lugares y datos de ubicación para Mapas y otras apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les cartes, les lieux et les données de localisation pour Plans et d’autres apps."
          }
        }
      }
    },
    "Downloads system assets macOS uses, such as fonts, dictionaries, voices and machine-learning models." : {
      "comment" : "What the macOS service com.apple.mobileassetd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Systemressourcen herunter, die macOS verwendet, etwa Schriften, Wörterbücher, Stimmen und Modelle für maschinelles Lernen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga recursos del sistema que usa macOS, como tipos de letra, diccionarios, voces y modelos de aprendizaje automático."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharge les ressources système utilisées par macOS, comme les polices, les dictionnaires, les voix et les modèles d’apprentissage automatique."
          }
        }
      }
    },
    "Fetches suggestions for Spotlight, Safari and Look Up." : {
      "comment" : "What the macOS service com.apple.parsecd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruft Vorschläge für Spotlight, Safari und „Nachschlagen“ ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiene sugerencias para Spotlight, Safari y Consultar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupère les suggestions pour Spotlight, Safari et Recherche."
          }
        }
      }
    },
    "Find My: locates your devices and items." : {
      "comment" : "What the macOS service com.apple.icloud.searchpartyd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Wo ist?“: ortet deine Geräte und Objekte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrar: localiza tus dispositivos y objetos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Localiser : localise vos appareils et vos objets."
          }
        }
      }
    },
    "Gatekeeper: checks apps when they open, including whether Apple has notarized them." : {
      "comment" : "What the macOS service com.apple.syspolicyd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper: prüft Apps beim Öffnen, auch ob Apple sie beglaubigt hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper: comprueba las apps al abrirlas, incluido si Apple las ha notarizado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gatekeeper : vérifie les apps à leur ouverture, notamment si Apple les a notariées."
          }
        }
      }
    },
    "Handles AirDrop, Handoff and other sharing between your devices." : {
      "comment" : "What the macOS service com.apple.sharingd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet AirDrop, Handoff und anderes Teilen zwischen deinen Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona AirDrop, Handoff y otras formas de compartir entre tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère AirDrop, Handoff et les autres partages entre vos appareils."
          }
        }
      }
    },
    "Handles Family Sharing." : {
      "comment" : "What the macOS service com.apple.familycircled does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet die Familienfreigabe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona En familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère le Partage familial."
          }
        }
      }
    },
    "Handles Siri requests." : {
      "comment" : "What the macOS service com.apple.assistantd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verarbeitet Siri-Anfragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona las solicitudes a Siri."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère les requêtes Siri."
          }
        }
      }
    },
    "Handles iCloud Private Relay and other network proxies macOS manages." : {
      "comment" : "What the macOS service com.apple.networkserviceproxy does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet iCloud Privat-Relay und andere Netzwerk-Proxys, die macOS steuert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona Relay privado de iCloud y otros proxies de red que administra macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère le relais privé iCloud et les autres proxys réseau gérés par macOS."
          }
        }
      }
    },
    "Keeps a connection to Apple's push notification service, which delivers notifications and wake-ups for apps." : {
      "comment" : "What the macOS service com.apple.apsd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hält die Verbindung zu Apples Push-Mitteilungsdienst, der Mitteilungen zustellt und Apps aufweckt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene una conexión con el servicio de notificaciones push de Apple, que entrega notificaciones y activaciones a las apps."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintient une connexion au service de notifications push d’Apple, qui transmet les notifications et les réveils des apps."
          }
        }
      }
    },
    "Loads web content for Safari and for apps that show web pages." : {
      "comment" : "What the macOS service com.apple.WebKit.Networking does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt Webinhalte für Safari und für Apps, die Webseiten anzeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga contenido web para Safari y para las apps que muestran páginas web."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charge le contenu web pour Safari et pour les apps qui affichent des pages web."
          }
        }
      }
    },
    "Looks up names for the whole Mac (DNS) and finds devices on the local network (Bonjour)." : {
      "comment" : "What the macOS service com.apple.mDNSResponder does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löst Namen für den ganzen Mac auf (DNS) und findet Geräte im lokalen Netzwerk (Bonjour)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resuelve nombres para todo el Mac (DNS) y encuentra dispositivos en la red local (Bonjour)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résout les noms pour tout le Mac (DNS) et trouve les appareils du réseau local (Bonjour)."
          }
        }
      }
    },
    "Looks up the names of Windows (SMB) computers on the local network." : {
      "comment" : "What the macOS service com.apple.netbiosd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermittelt die Namen von Windows-Computern (SMB) im lokalen Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca los nombres de los equipos Windows (SMB) de la red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résout les noms des ordinateurs Windows (SMB) du réseau local."
          }
        }
      }
    },
    "Mail, Apple's email app." : {
      "comment" : "What the macOS service com.apple.mail does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
