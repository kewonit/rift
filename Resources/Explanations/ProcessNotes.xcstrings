    "Provides Location Services; it can look up nearby Wi-Fi networks with Apple to find the Mac's position." : {
      "comment" : "What the macOS service com.apple.locationd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Ortungsdienste bereit. Kann WLAN-Netzwerke in der Nähe bei Apple abfragen, um die Position des Mac zu bestimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proporciona la Localización; puede consultar con Apple las redes Wi-Fi cercanas para averiguar la posición del Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fournit le Service de localisation ; il peut interroger Apple sur les réseaux Wi-Fi proches pour trouver la position du Mac."
          }
        }
      }
    },
    "Registers your devices for Messages, FaceTime and other Apple services that use your phone number or email address." : {
      "comment" : "What the macOS service com.apple.identityservicesd does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registriert deine Geräte für Nachrichten, FaceTime und andere Apple-Dienste, die deine Telefonnummer oder E-Mail-Adresse nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tus dispositivos para Mensajes, FaceTime y otros servicios de Apple que usan tu número de teléfono o tu correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre vos appareils pour Messages, FaceTime et d’autres services Apple qui utilisent votre numéro de téléphone ou votre adresse e-mail."
          }
        }
      }
    },
    "Safari, Apple's web browser." : {
      "comment" : "What the macOS service com.apple.Safari does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, der Webbrowser von Apple."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
