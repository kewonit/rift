          "stringUnit" : {
            "state" : "translated",
            "value" : "Safari, le navigateur web d’Apple."
          }
        }
      }
    },
    "Sends and receives messages for the Messages app." : {
      "comment" : "What the macOS service com.apple.imagent does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet und empfängt Nachrichten für die App „Nachrichten“."
          }
        },
        "es" : {
          "stringUnit" : {
